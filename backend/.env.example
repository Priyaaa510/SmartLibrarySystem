# PostgreSQL connection (SQLAlchemy URL using the psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/smart_library
# Used only by the test-suite; this database is wiped on every test run
TEST_DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/smart_library_test
# JWT signing key - use a long random string in production
SECRET_KEY=change-me
# Optional overrides
# ACCESS_TOKEN_MINUTES=720
# HOLD_PICKUP_DAYS=3
# SEED_DEMO_DATA=true
# RUN_SCHEDULER=true
